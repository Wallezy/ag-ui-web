{
  "name": "agent-platform-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.10.0"
  },
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc -b && vite build --config vite.config.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "smoke:dev-stable": "node --experimental-strip-types --test tests/runtime-http-agent.test.ts tests/task-delta.test.ts tests/oa-public-events.test.ts tests/daily-report-confirmation.test.ts tests/api-error.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --config vite.config.ts",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "knip": "knip"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@assistant-ui/react": "0.14.26",
    "@assistant-ui/react-ag-ui": "0.0.44",
    "@assistant-ui/react-markdown": "^0.14.5",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-router": "^1.132.47",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.11",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@tanstack/router-plugin": "^1.132.51",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.23",
    "globals": "^16.4.0",
    "knip": "^5.64.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.46.0",
    "vite": "8.1.3"
  }
}
